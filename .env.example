# Telegram bot token from @BotFather. Leave empty to run the web app only.
BOT_TOKEN=

# all (web + bot, default) | web | bot
MODE=all

# Web server
HOST=0.0.0.0
PORT=8080
MAX_UPLOAD_MB=15

# Public HTTPS URL of the web app. If set, /start shows an "Open web app" button
# (Telegram Mini App). Must be https://
WEB_URL=

# u2net (fast, default) | isnet-general-use (sharper edges, slower)
REMBG_MODEL=u2net
# Longest image side before inference; lower = less RAM/CPU
MAX_DIM=2048
# Simultaneous cutouts across web + bot
MAX_CONCURRENCY=2
